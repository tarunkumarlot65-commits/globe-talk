# Copy this file to .env and fill it in. Never share or commit .env.

# The name shown in the app and in emails. Change it any time.
APP_NAME=GlobeTalk

# Set to 1 ONLY if your site is behind Cloudflare. Then the visitor's real country
# (from their IP) is used instead of what they pick in the dropdown.
TRUST_CLOUDFLARE=0

# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=bcf00e49ed88c1d5d3843d06ce2e46cadf6dd7ea4c0f8ede24b7a182bcabd057

# Google Sign-In (see setup steps): the OAuth "Web application" client ID
GOOGLE_CLIENT_ID=

# Email OTP via any SMTP service (Brevo, Gmail app password, Resend SMTP, Zoho, etc.)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Chaupal <no-reply@yourdomain.com>"

# Optional: AI nudity thresholds
# NSFW_THRESHOLD=0.75
# NSFW_INSTANT_BAN=0.92

# Live translation (voice + text). Set ONE of these. With neither, a fake "mock" mode is used for testing.
GOOGLE_TRANSLATE_KEY=
# LIBRETRANSLATE_URL=https://your-libretranslate-server
# LIBRETRANSLATE_KEY=
# Per-account daily limit in characters (protects your translation bill)
# TRANSLATE_DAILY_CHARS=60000

# Facebook Login (get these from developers.facebook.com -> your app -> Settings > Basic)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional: proxycheck.io API key for higher VPN/proxy-detection limits (works without a key too, at a lower free rate)
PROXYCHECK_API_KEY=
